# =====================================================================
# Plant Green Inertia - Production Environment Configuration (Render)
# =====================================================================

# Server & Runtime
PORT=8787
NODE_ENV=production
PUBLIC_BASE_URL=https://internship.plantgreeninertia.com

# Supabase PostgreSQL & Auth Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Razorpay Payment Gateway (Live credentials for Render)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret

# Transactional Email Service (Resend)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Plant Green Inertia <admissions@plantgreeninertia.com>

# Assessment & Proctoring Configuration
REQUIRE_CAMERA=true
EVIDENCE_RETENTION_DAYS=7

# Optional External Attendance System Integration
# If not configured, uses the integrated `student_attendance` database table
ATTENDANCE_API_URL=
ATTENDANCE_API_SECRET=
ATTENDANCE_EMBED_URL=
